{
  "name": "mental-auto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mental-auto": "./dist/index.js"
  },
  "scripts": {
    "hooks:install": "git config --local core.hooksPath .githooks",
    "check:generated": "node scripts/check-generated.mjs",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "doctor": "node dist/doctor.js",
    "test": "vitest run",
    "test:generated": "node --test scripts/test-generated-guard.mjs",
    "test:smoke": "node scripts/quick-start-smoke.mjs",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
